# Copy to .env in the repository root (next to docker-compose.yml).
# Read by docker compose only; each client's backend settings are in clients/<name>.env.

# Password of the postgres superuser. Used only by the tools container to
# create client databases; client backends connect with their own user.
POSTGRES_PASSWORD=change-me

# Copied into new client env files by provision_client (can be changed per client)
GEMINI_API_KEY=

# Linux only: your user and group id (id -u / id -g), so files the tools
# container writes in clients/ belong to you
HOST_UID=1000
HOST_GID=1000
