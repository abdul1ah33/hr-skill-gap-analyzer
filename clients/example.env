# Backend settings for one client. provision_client creates clients/<name>.env
# for you; this file only shows the format. Real client files are not committed.
DATABASE_URL=postgresql+psycopg://client_a:DATABASE_PASSWORD@postgres:5432/client_a
# Must be unique per client: one client's tokens are then rejected by the others
SECRET_KEY=a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GEMINI_API_KEY=
# The client's frontend URL
CORS_ORIGINS=http://client-a.localhost
# Small pools so many clients fit within PostgreSQL's max_connections
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
